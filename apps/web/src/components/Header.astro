---
import { navIconPaths, navLinks } from "../lib/nav";

interface Props {
  counts?: { interested: number; notInterested: number };
}

const { counts } = Astro.props;
const path = Astro.url.pathname;
const links = navLinks(counts);
---

<header
  class="sticky top-0 z-30 flex h-14 shrink-0 items-center gap-6 border-b border-border bg-surface px-4"
>
  <a href="/" class="shrink-0 leading-tight">
    <span class="block text-[15px] font-bold tracking-[-0.01em]">JOE Tracker</span>
    <span class="meta block text-[11px]">Job market triage</span>
  </a>

  <nav class="flex items-center gap-1" aria-label="Main">
    {
      links.map((link) => {
        const active = path === link.href;
        return (
          <a
            href={link.href}
            aria-current={active ? "page" : undefined}
            class:list={[
              "flex items-center gap-2 rounded px-2.5 py-1.5 text-sm transition-colors",
              active
                ? "bg-primary font-semibold text-primary-fg"
                : "text-ink-soft hover:bg-subtle hover:text-ink",
            ]}
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="size-4 shrink-0 opacity-80"
              aria-hidden="true"
            >
              <path d={navIconPaths[link.icon]} />
            </svg>
            {link.label}
            {link.countKey && link.count != null && (
              <span
                data-count={link.countKey}
                class:list={[
                  "nums text-xs",
                  active ? "text-primary-fg/70" : "text-muted",
                ]}
              >
                {link.count}
              </span>
            )}
          </a>
        );
      })
    }
  </nav>
</header>
