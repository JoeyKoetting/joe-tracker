---
import { actions } from "astro:actions";
import ApplicationDetails from "./ApplicationDetails.astro";
import PostingLinks from "./PostingLinks.astro";
import type { ListingWithRelations } from "@joe/db";
import {
  daysUntil,
  deadlineTone,
  locationLabel,
  postedDate,
  shortDate,
} from "../lib/format";

interface Props {
  listing: ListingWithRelations;
}

const { listing } = Astro.props;
const days = daysUntil(listing.applicationDeadline);
const tone = deadlineTone(days);
const deadline = shortDate(listing.applicationDeadline);
const review = shortDate(listing.reviewDate);
const deadlineLabel = listing.reviewDate === listing.applicationDeadline
  ? "First review"
  : "Deadline";
const posted = shortDate(postedDate(listing));
const reviewDays = daysUntil(listing.reviewDate);
const reviewTone = deadlineTone(reviewDays);
const place = locationLabel(listing);
const originalPostingUrl = `https://www.aeaweb.org/joe/listing.php?JOE_ID=${listing.joeYear}-${String(listing.joeIssueId).padStart(2, "0")}_${listing.jpId}`;

const facts = [
  { label: "Location", value: place ?? "—" },
  { label: "Posted", value: posted ?? "—" },
  { label: "Section", value: listing.section },
  { label: "Salary", value: listing.salaryRange },
].filter((fact) => fact.value);
---

<article
  class="mark-row flex h-full min-h-0 flex-col"
  data-jp-id={listing.jpId}
  data-mark={listing.mark?.state ?? "interested"}
  data-title={listing.title ?? "(untitled)"}
>
  <div
    class="flex shrink-0 flex-wrap items-center gap-2 border-b border-border px-4 py-2.5"
  >
    <span class="meta nums">Listing ID: #{listing.jpId}</span>
    <div class="ml-auto flex gap-2">
      <form method="POST" action={actions.setMark} class="mark-form">
        <input type="hidden" name="jpId" value={listing.jpId} />
        <input type="hidden" name="state" value="interested" />
        <button
          type="submit"
          class:list={["btn-sm", listing.mark?.state === "interested" ? "btn-good" : "btn-good-idle"]}
          data-state="interested"
        >
          Interested
        </button>
      </form>
      <form method="POST" action={actions.setMark} class="mark-form">
        <input type="hidden" name="jpId" value={listing.jpId} />
        <input type="hidden" name="state" value="applied_to" />
        <button
          type="submit"
          class:list={["btn-sm", listing.mark?.state === "applied_to" ? "btn-applied" : "btn-applied-idle"]}
          data-state="applied_to"
        >
          Applied to
        </button>
      </form>
      <form method="POST" action={actions.setMark} class="mark-form">
        <input type="hidden" name="jpId" value={listing.jpId} />
        <input type="hidden" name="state" value="not_interested" />
        <button
          type="submit"
          class:list={["btn-sm", listing.mark?.state === "not_interested" ? "btn-bad" : "btn-bad-idle"]}
          data-state="not_interested"
        >
          Not Interested
        </button>
      </form>
    </div>
  </div>

  <div class="min-h-0 flex-1 overflow-y-auto px-4 py-4">
    <div class="flex flex-wrap items-center gap-2">
      {
        deadline && (
          <span
            class:list={[
              "nums",
              tone === "past" || tone === "soon" ? "badge-bad" : "badge-neutral",
            ]}
          >
            {deadlineLabel}: {deadline}
            {days != null &&
              ` (${days < 0 ? `${-days}d ago` : `${days}d left`})`}
          </span>
        )
      }
      {
        review && listing.reviewDate !== listing.applicationDeadline && (
          <span
            class:list={[
              "nums",
              reviewTone === "past" || reviewTone === "soon" ? "badge-bad" : "badge-neutral",
            ]}
          >
            First review: {review}
            {reviewDays != null &&
              ` (${reviewDays < 0 ? `${-reviewDays}d ago` : `${reviewDays}d left`})`}
          </span>
        )
      }
      {
        listing.section && (
          <span class="badge-neutral max-w-72 truncate" title={listing.section}>
            {listing.section}
          </span>
        )
      }
    </div>

    <h2 class="mt-2 text-2xl leading-8 font-bold tracking-[-0.02em]">
      {listing.title ?? "(untitled)"}
    </h2>
    <p class="mt-1 text-sm text-ink-soft">
      {listing.institution ?? "Unknown institution"}
      {listing.department && <span> — {listing.department}</span>}
      {listing.division && <span> · {listing.division}</span>}
    </p>

    <dl class="mt-4 grid gap-2 sm:grid-cols-2 xl:grid-cols-4">
      <div class="card px-3 py-2">
        <dt class="label-data">JEL codes</dt>
        <dd class="mt-1 flex flex-wrap gap-1">
          {
            listing.jel.length === 0 ? (
              <span class="meta">—</span>
            ) : (
              listing.jel.map((j) => (
                <span class="badge-neutral" title={j.description ?? undefined}>
                  {j.code}
                </span>
              ))
            )
          }
        </dd>
      </div>
      <a
        class="card block px-3 py-2 transition-colors hover:border-accent hover:bg-subtle"
        href={originalPostingUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`Open original JOE posting for ${listing.title ?? "this listing"}`}
      >
        <dt class="label-data">Original posting</dt>
        <dd class="mt-1 text-sm font-medium text-accent">View on JOE ↗</dd>
      </a>
      {
        facts.map((fact) => (
          <div class="card px-3 py-2">
            <dt class="label-data">{fact.label}</dt>
            <dd class="nums mt-1 text-sm">{fact.value ?? "—"}</dd>
          </div>
        ))
      }
      <PostingLinks
        text={listing.fullText}
        applicationUrl={listing.applicationUrl}
        referenceUrl={listing.referenceUrl}
        cards
      />
    </dl>

    <ApplicationDetails listing={listing} />

    <form
      method="POST"
      action={actions.updateNote}
      class="note-form mt-5"
      data-jp-id={listing.jpId}
    >
      <label class="label-data mb-1" for={`note-${listing.jpId}`}>
        My private notes
      </label>
      <input type="hidden" name="jpId" value={listing.jpId} />
      <textarea
        id={`note-${listing.jpId}`}
        name="note"
        rows="4"
        class="input resize-y"
        placeholder="Faculty contacts, research fit, documents to prepare…"
        >{listing.mark?.note ?? ""}</textarea
      >
      <p class="meta note-status mt-1 text-right text-[11px]">
        Changes save automatically
      </p>
    </form>

    {
      listing.fullText && (
        <section class="mt-6 border-t border-border pt-4">
          <h3 class="label-data mb-2">Full posting text</h3>
          <div class="max-w-[70ch] text-sm leading-6 whitespace-pre-wrap text-ink-soft">
            {listing.fullText}
          </div>
        </section>
      )
    }
  </div>
</article>
