{
  "name": "joe-tracker",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@11.6.0",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "pnpm --filter @joe/web dev",
    "build": "pnpm --filter @joe/web build",
    "preview": "pnpm --filter @joe/web preview",
    "format": "prettier --write .",
    "lint": "pnpm --filter @joe/web check",
    "test": "vitest run",
    "migrate": "tsx scripts/migrate.ts",
    "ingest": "tsx scripts/ingest.ts"
  },
  "dependencies": {
    "@joe/core": "workspace:*",
    "@joe/db": "workspace:*"
  },
  "devDependencies": {
    "prettier": "^3.9.4",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tsx": "^4.21.0",
    "vitest": "^4.1.10"
  }
}
