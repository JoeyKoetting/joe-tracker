---
import BaseLayout from "../layouts/BaseLayout.astro";
import InterestedDetail from "./InterestedDetail.astro";
import { getDb } from "../lib/db";
import { countMarks, listAllByMark } from "@joe/db";
import { daysUntil, deadlineTone, shortDate } from "../lib/format";

interface Props {
  state: "interested" | "maybe";
}
const { state } = Astro.props;
const heading = state === "maybe" ? "Maybe" : "Interested";
const path = `/${state}`;
const sortOptions = [
  ["review_asc", "Priority deadline soonest"],
  ["deadline_asc", "Posted deadline soonest"],
  ["date_desc", "Newest posted"],
  ["institution_asc", "Institution A–Z"],
] as const;
const sort =
  sortOptions.find(
    ([value]) => value === Astro.url.searchParams.get("sort"),
  )?.[0] ?? "review_asc";
const listingHref = (id: number) =>
  `${path}?${new URLSearchParams({ id: String(id), sort })}`;
const db = getDb();
const [rows, counts] = await Promise.all([
  listAllByMark(db, state, sort),
  countMarks(db),
]);

const requested = Number(Astro.url.searchParams.get("id"));
const selected =
  rows.find((listing) => listing.jpId === requested) ?? rows[0] ?? null;
---

<BaseLayout
  title={`${heading} · JOE Tracker`}
  heading={heading}
  subtitle={`${rows.length} ${state === "maybe" ? "tentatively interested" : "shortlisted"}`}
  counts={counts}
  flush={rows.length > 0}
>
  <form
    slot="actions"
    method="GET"
    action={path}
    data-shortlist-sort
    class="flex items-center gap-2"
  >
    {selected && <input type="hidden" name="id" value={selected.jpId} />}
    <label for="shortlist-sort" class="label-data">Sort</label>
    <select id="shortlist-sort" name="sort" class="input w-auto">
      {
        sortOptions.map(([value, label]) => (
          <option value={value} selected={sort === value}>
            {label}
          </option>
        ))
      }
    </select>
    <noscript
      ><button class="btn-ghost btn-sm" type="submit">Sort</button></noscript
    >
  </form>
  {
    rows.length === 0 ? (
      <div class="px-4 py-4">
        <div class="card px-4 py-10 text-center">
          <p class="text-sm font-medium">
            {state === "maybe" ? "No maybes yet." : "Nothing shortlisted yet."}
          </p>
          <p class="meta mt-1">
            Browse{" "}
            <a href="/" class="font-medium underline">
              all listings
            </a>{" "}
            and mark the ones worth a closer look.
          </p>
        </div>
      </div>
    ) : (
      <div class="flex h-full min-h-0 flex-col md:flex-row">
        <div
          data-shortlist-scroll="mobile"
          class="border-border bg-surface flex gap-1 overflow-x-auto border-b px-3 py-2 md:hidden"
        >
          {rows.map((listing) => (
            <a
              href={listingHref(listing.jpId)}
              class:list={[
                "rounded border px-2.5 py-1 text-[13px] whitespace-nowrap",
                selected?.jpId === listing.jpId
                  ? state === "maybe"
                    ? "border-warn bg-warn-soft text-warn-ink"
                    : "border-good bg-good-soft text-good-ink"
                  : "border-border text-ink-soft",
              ]}
            >
              {listing.institution ?? "Unknown"}
            </a>
          ))}
        </div>

        <div class="border-border bg-surface flex w-72 shrink-0 flex-col border-r max-md:hidden">
          <div class="border-border shrink-0 border-b px-3 py-2">
            <span class="label-data">
              {heading} <span class="nums">({rows.length})</span>
            </span>
          </div>
          <ul
            data-shortlist-scroll="desktop"
            class="divide-border min-h-0 flex-1 divide-y overflow-y-auto"
          >
            {rows.map((listing) => {
              const active = selected?.jpId === listing.jpId;
              const date =
                sort === "review_asc"
                  ? listing.reviewDate
                  : listing.applicationDeadline;
              const days = daysUntil(date);
              const tone = deadlineTone(days);
              const deadline = shortDate(date);
              return (
                <li>
                  <a
                    href={listingHref(listing.jpId)}
                    aria-current={active ? "true" : undefined}
                    class:list={[
                      "block border-l-2 px-3 py-2 transition-colors",
                      active
                        ? state === "maybe"
                          ? "border-l-warn bg-warn-soft"
                          : "border-l-good bg-subtle"
                        : "hover:bg-subtle border-l-transparent",
                    ]}
                  >
                    <div class="flex items-start gap-2">
                      <span class="text-ink min-w-0 flex-1 truncate text-[13px] font-semibold">
                        {listing.institution ?? "Unknown institution"}
                      </span>
                      {deadline && (
                        <span
                          class:list={[
                            "nums",
                            tone === "past" || tone === "soon"
                              ? "badge-bad"
                              : "badge-neutral",
                          ]}
                        >
                          {sort === "review_asc" ? "Priority: " : "Deadline: "}
                          {deadline}
                        </span>
                      )}
                    </div>
                    <p class="meta mt-0.5 truncate">
                      {listing.title ?? "(untitled)"}
                    </p>
                    {listing.jel.length > 0 && (
                      <div class="mt-1 flex flex-wrap gap-1">
                        {listing.jel.slice(0, 3).map((j) => (
                          <span class="badge-neutral">{j.code}</span>
                        ))}
                      </div>
                    )}
                  </a>
                </li>
              );
            })}
          </ul>
        </div>

        <div class="min-h-0 min-w-0 flex-1 overflow-hidden">
          {selected ? (
            <InterestedDetail listing={selected} />
          ) : (
            <p class="meta p-4">Select a listing from the shortlist.</p>
          )}
        </div>
      </div>
    )
  }
</BaseLayout>

<script>
  import "../scripts/mark.ts";
  import "../scripts/note.ts";
  import "../scripts/shortlist.ts";
</script>
